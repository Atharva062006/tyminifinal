{
  "name": "apnileap",
  "version": "1.0.0",
  "description": "APNILEAP — Rule-Based Placement Eligibility and Performance Analytics",
  "private": true,
  "workspaces": [
    "shared",
    "services/team-a-eligibility",
    "services/team-b-ranking",
    "services/team-c-placement",
    "services/team-d-portal"
  ],
  "scripts": {
    "start:all": "node scripts/start-all.js",
    "start:a": "npm start --prefix services/team-a-eligibility",
    "start:b": "npm start --prefix services/team-b-ranking",
    "start:c": "npm start --prefix services/team-c-placement",
    "start:d": "npm start --prefix services/team-d-portal",
    "seed": "node scripts/seed-data.js",
    "health": "node scripts/health-check.js",
    "test": "npm test --workspaces --if-present",
    "reset": "node scripts/reset-data.js",
    "test:a": "npm test --prefix services/team-a-eligibility",
    "test:b": "npm test --prefix services/team-b-ranking",
    "test:c": "npm test --prefix services/team-c-placement",
    "test:d": "npm test --prefix services/team-d-portal",
    "kpi": "node scripts/kpi-report.js"
  }
}
