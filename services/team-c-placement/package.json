{
  "name": "@apnileap/team-c-placement",
  "version": "1.0.0",
  "description": "Team C — Placement Data & Transaction Manager (DBMS Engine)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --passWithNoTests --runInBand --forceExit",
    "test:db": "jest tests/db --passWithNoTests --runInBand",
    "test:api": "jest tests/application tests/idempotency tests/concurrency tests/audit --passWithNoTests --runInBand"
  },
  "dependencies": {
    "express": "^4.22.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "license": "MIT"
}
