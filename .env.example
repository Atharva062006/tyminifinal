# RIT Campus Placement & Eligibility System — environment template (all values optional; defaults shown)
NODE_ENV=development

# Service endpoints
TEAM_A_URL=http://localhost:3001
TEAM_B_URL=http://localhost:3002
TEAM_C_URL=http://localhost:3003
TEAM_C_STREAM_URL=http://localhost:3003/api/v1/stream

# Trust & sessions (change both outside a classroom demo)
INTERNAL_SERVICE_SECRET=rit_placement_internal_secret_key
JWT_SECRET=rit_placement_jwt_signing_secret
SESSION_TTL_SECONDS=28800

# Team C
AUTO_SEED=true            # seed demo data when the database is empty
ENGINE_TIMEOUT_MS=3000    # Team C -> Team A/B call timeout

# Team A
QUEUE_POLICY=PRIORITY     # FIFO | CIRCULAR | PRIORITY | HEAP

# Mock adapters in the BFF (offline demos / unit tests only). Real data is the default.
MOCK_TEAM_A=false
MOCK_TEAM_B=false
MOCK_TEAM_C=false
