# RIT Campus Placement & Eligibility System — Environment Configuration Template
NODE_ENV=development
PORT=3000

# Service Endpoints
TEAM_A_URL=http://localhost:3001
TEAM_B_URL=http://localhost:3002
TEAM_C_URL=http://localhost:3003
TEAM_C_STREAM_URL=http://localhost:3003/api/v1/stream

# Internal Microservice Security Keys (Do NOT commit real production secrets)
INTERNAL_SERVICE_SECRET=rit_placement_internal_secret_key_change_in_prod
JWT_SECRET=rit_placement_jwt_signing_secret_change_in_prod

# Mock Control Mode (Set to false for real inter-service production communication)
MOCK_MODE=false
MOCK_TEAM_A=false
MOCK_TEAM_B=false
MOCK_TEAM_C=false
